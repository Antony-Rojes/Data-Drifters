# Copy this file to .env and put your key after the = sign (no quotes, no spaces).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional: used automatically when the main model is overloaded (503) or not found
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Optional: embedding model for meaning-based search
GEMINI_EMBED_MODEL=gemini-embedding-001
